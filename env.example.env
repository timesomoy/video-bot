# Copy to .env (never commit it, never paste real keys into a chat or a zip).
# For the Telegram + GitHub Actions setup you do NOT need this file: the keys live in GitHub "Secrets" and Cloudflare secrets.
# It is only for running on your own PC / server.

TELEGRAM_BOT_TOKEN= 
GEMINI_API_KEY= 
# Model ID, not the display name. Default is gemini-4-hydrogen; fallbacks are tried automatically.
# GEMINI_MODEL=gemini-4-hydrogen

# Optional: websites the robot must never open (comma separated), on top of the built-in internal-address blocks
# AUTOVIDEO_BLOCKED_HOSTS=
# Screen size of the virtual display on a server
# AUTOVIDEO_SCREEN=1920x1080x24
